{
  "name": "guess-the-song",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:vercel": "bunx vercel dev",
    "deploy:prepare": "bun scripts/prepare-deployment.ts",
    "build": "bun run --bun next build --webpack",
    "start": "bun scripts/dev.ts --production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "bun test tests --env-file=.env.local",
    "local:database": "bun scripts/local-database.ts",
    "local:setup": "bun scripts/setup-local.ts",
    "test:e2e": "node --env-file=.env.local node_modules/@playwright/test/cli.js test",
    "db:migrate": "bun run --env-file=.env.local scripts/migrate.ts",
    "catalog:import": "bun run --env-file=.env.local scripts/import-catalog.ts",
    "catalog:hits": "bun run --env-file=.env.local scripts/import-hits.ts",
    "catalog:organize": "bun run --env-file=.env.local scripts/organize-catalog.ts",
    "music:discover": "bun scripts/discover-music.ts",
    "catalog:stars": "bun run --env-file=.env.local scripts/featured-hits.ts",
    "catalog:artists": "bun run --env-file=.env.local scripts/import-artist-packs.ts",
    "admin:password": "bun scripts/admin-password.ts"
  },
  "dependencies": {
    "@hono/vercel": "1.0.0",
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.21",
    "@tanstack/react-query": "5.104.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "3.9.11",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.13",
    "ioredis": "6.0.0",
    "lucide-react": "1.52.0",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "tailwind-merge": "3.7.0",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vercel": "62.2.0"
  }
