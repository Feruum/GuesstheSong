# Copy to .env.local. Use different databases and secrets for preview and production.
# Vercel deploy:prepare requires cloud PostgreSQL with sslmode=require, rediss:// Redis,
# an exact public HTTPS APP_URL and a SESSION_SECRET of at least 32 characters.
DATABASE_URL=postgresql://music:music@127.0.0.1:5432/music
REDIS_URL=redis://127.0.0.1:6379
APP_URL=http://127.0.0.1:3000
SESSION_SECRET=
ADMIN_PASSWORD_HASH=
# Base64 is convenient for Argon2 hashes containing dollar signs in dotenv files.
ADMIN_PASSWORD_HASH_BASE64=
CRON_SECRET=
AUDIUS_API_KEY=
AUDIUS_APP_NAME=guess-the-song
# Opt-in for private noncommercial listening on a loopback APP_URL only.
# Automatically disabled for a public APP_URL. Review provider terms before hosting.
DEEZER_PRIVATE_PREVIEWS=false
# The local Bun WebSocket bridge shares cookies, PostgreSQL and Redis with Next.js.
NEXT_PUBLIC_WS_PATH=/api/ws
SOCKET_PORT=3001
REDIS_NAMESPACE=gts
